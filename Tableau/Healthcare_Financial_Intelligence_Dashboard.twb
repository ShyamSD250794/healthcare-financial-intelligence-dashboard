          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI - Current Quarter Label' datatype='string' hidden='true' name='[Calculation_1257886796062750]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF RIGHT(STR({ MAX([YEAR_QTR]) }), 1) = &quot;1&quot; THEN&#13;&#10;    STR(INT({ MAX([YEAR_QTR]) } / 10)) + &quot; Q1&quot;&#13;&#10;ELSEIF RIGHT(STR({ MAX([YEAR_QTR]) }), 1) = &quot;2&quot; THEN&#13;&#10;    STR(INT({ MAX([YEAR_QTR]) } / 10)) + &quot; Q2&quot;&#13;&#10;ELSEIF RIGHT(STR({ MAX([YEAR_QTR]) }), 1) = &quot;3&quot; THEN&#13;&#10;    STR(INT({ MAX([YEAR_QTR]) } / 10)) + &quot; Q3&quot;&#13;&#10;ELSE&#13;&#10;    STR(INT({ MAX([YEAR_QTR]) } / 10)) + &quot; Q4&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Quarter Label' datatype='string' name='[Calculation_1257886796623903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; THEN&#13;&#10;    &quot;All&quot;&#13;&#10;ELSE&#13;&#10;    [Parameters].[Parameter 1784005467074563]&#13;&#10;END' />
      </column>
      <column caption='KPI - Operating Margin QoQ Display' datatype='string' hidden='true' name='[Calculation_1257886810566691]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MEDIAN([OPERATING_MARGIN_PCT]), -1)) THEN&#13;&#10;    NULL&#13;&#10;&#13;&#10;ELSEIF MEDIAN([OPERATING_MARGIN_PCT])&#13;&#10;       - LOOKUP(MEDIAN([OPERATING_MARGIN_PCT]), -1) &gt; 0 THEN&#13;&#10;&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            MEDIAN([OPERATING_MARGIN_PCT])&#13;&#10;            - LOOKUP(MEDIAN([OPERATING_MARGIN_PCT]), -1),&#13;&#10;            2&#13;&#10;        )&#13;&#10;    )&#13;&#10;    + &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF MEDIAN([OPERATING_MARGIN_PCT])&#13;&#10;       - LOOKUP(MEDIAN([OPERATING_MARGIN_PCT]), -1) &lt; 0 THEN&#13;&#10;&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            ABS(&#13;&#10;                MEDIAN([OPERATING_MARGIN_PCT])&#13;&#10;                - LOOKUP(MEDIAN([OPERATING_MARGIN_PCT]), -1)&#13;&#10;            ),&#13;&#10;            2&#13;&#10;        )&#13;&#10;    )&#13;&#10;    + &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00 pp vs prior quarter&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI - Total Margin QoQ Display' datatype='string' hidden='true' name='[Calculation_1257886819909668]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MEDIAN([TOTAL_MARGIN_PCT]), -1)) THEN&#13;&#10;    NULL&#13;&#10;&#13;&#10;ELSEIF MEDIAN([TOTAL_MARGIN_PCT])&#13;&#10;       - LOOKUP(MEDIAN([TOTAL_MARGIN_PCT]), -1) &gt; 0 THEN&#13;&#10;&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            MEDIAN([TOTAL_MARGIN_PCT])&#13;&#10;            - LOOKUP(MEDIAN([TOTAL_MARGIN_PCT]), -1),&#13;&#10;            2&#13;&#10;        )&#13;&#10;    ) +&#13;&#10;    &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF MEDIAN([TOTAL_MARGIN_PCT])&#13;&#10;       - LOOKUP(MEDIAN([TOTAL_MARGIN_PCT]), -1) &lt; 0 THEN&#13;&#10;&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            ABS(&#13;&#10;                MEDIAN([TOTAL_MARGIN_PCT])&#13;&#10;                - LOOKUP(MEDIAN([TOTAL_MARGIN_PCT]), -1)&#13;&#10;            ),&#13;&#10;            2&#13;&#10;        )&#13;&#10;    ) +&#13;&#10;    &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00 pp vs prior quarter&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PB - Revenue vs Peer Median %' datatype='string' name='[Calculation_1327706515152896]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(MIN([PEER_MEDIAN_NET_TOT]))&#13;&#10;   OR MIN([PEER_MEDIAN_NET_TOT]) = 0&#13;&#10;THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(&#13;&#10;        (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100,&#13;&#10;        2&#13;&#10;    )) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='PB - Operating Margin vs Peer Δ' datatype='string' name='[Calculation_1507751893614592]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;+&quot; +&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='PB - Operating Margin Δ Color' datatype='string' name='[Calculation_1507751895638017]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF ABS(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) &lt;= 0.05 THEN&#13;&#10;    &quot;Neutral&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;Positive&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Negative&quot;&#13;&#10;END' />
      </column>
      <column caption='PB - Selected Quarter Highlight' datatype='real' name='[Calculation_1509677775921152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF STR([YEAR_QTR (VW_PEER_BENCHMARK)]) =&#13;&#10;   REPLACE([Parameters].[Parameter 1784005467074563], &quot; Q&quot;, &quot;&quot;)&#13;&#10;THEN&#13;&#10;    [OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)]&#13;&#10;END' />
      </column>
      <column caption='KPI - Current Ratio QoQ' datatype='string' hidden='true' name='[Calculation_1531665411256320]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MEDIAN([CURRENT_RATIO]), -1)) THEN&#13;&#10;    NULL&#13;&#10;ELSEIF MEDIAN([CURRENT_RATIO]) - LOOKUP(MEDIAN([CURRENT_RATIO]), -1) &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(ROUND(MEDIAN([CURRENT_RATIO]) - LOOKUP(MEDIAN([CURRENT_RATIO]), -1), 2))&#13;&#10;    + &quot;x vs prior quarter&quot;&#13;&#10;ELSEIF MEDIAN([CURRENT_RATIO]) - LOOKUP(MEDIAN([CURRENT_RATIO]), -1) &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(ROUND(ABS(MEDIAN([CURRENT_RATIO]) - LOOKUP(MEDIAN([CURRENT_RATIO]), -1)), 2))&#13;&#10;    + &quot;x vs prior quarter&quot;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00x vs prior quarter&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI - Facilities QoQ' datatype='string' hidden='true' name='[Calculation_1531665414778881]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(COUNTD([FAC_NO]), -1)) THEN&#13;&#10;    NULL&#13;&#10;ELSEIF COUNTD([FAC_NO]) - LOOKUP(COUNTD([FAC_NO]), -1) &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(ABS(COUNTD([FAC_NO]) - LOOKUP(COUNTD([FAC_NO]), -1)))&#13;&#10;    + &quot; vs prior quarter&quot;&#13;&#10;ELSEIF COUNTD([FAC_NO]) - LOOKUP(COUNTD([FAC_NO]), -1) &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(ABS(COUNTD([FAC_NO]) - LOOKUP(COUNTD([FAC_NO]), -1)))&#13;&#10;    + &quot; vs prior quarter&quot;&#13;&#10;ELSE&#13;&#10;    &quot;● 0 vs prior quarter&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
