              <calculation class='tableau' formula='IF [Calculation_1784005467848709] THEN [TOTAL_MARGIN_PCT] END' />
            </column>
            <column caption='P1 - Total Margin Prev' datatype='real' name='[Calculation_1784005473468432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] &lt;&gt; &quot;All&quot;&#13;&#10;   AND [Calculation_1784005465563136] = [Calculation_1784005467750404] - 1&#13;&#10;THEN [TOTAL_MARGIN_PCT] END' />
            </column>
            <column caption='P1 - Total Margin QoQ' datatype='real' name='[Calculation_1784005473542161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([Calculation_1784005473386511]) - MEDIAN([Calculation_1784005473468432])' />
            </column>
            <column caption='P1 - Total Margin QoQ Display' datatype='string' name='[Calculation_1784005484752929]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1784005473542161]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1784005473542161] &gt; 0 THEN &quot;▲ +&quot; + STR(ROUND([Calculation_1784005473542161], 2)) + &quot; pp&quot;&#13;&#10;ELSEIF [Calculation_1784005473542161] &lt; 0 THEN &quot;▼ &quot; + STR(ROUND([Calculation_1784005473542161], 2)) + &quot; pp&quot;&#13;&#10;ELSE &quot;— no change&quot;&#13;&#10;END' />
            </column>
