      <column caption='DQ - Records Subtitle' datatype='string' name='[Calculation_1191370218151960]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Data checks in &quot; + &#13;&#10;IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; &#13;&#10;THEN &quot;latest quarter (&quot; + STR(MAX([QUARTER_TXT])) + &quot;) · &apos;All&apos; shows latest quarter&quot;&#13;&#10;ELSE [Parameters].[Parameter 1784005467074563] &#13;&#10;END' />
      </column>
      <column caption='Current Median Net Patient Revenue' datatype='real' name='[Calculation_1257886752710670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    MEDIAN(&#13;&#10;        IF [Calculation_0081134069198851] THEN&#13;&#10;            [NET_TOT]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Previous Quarter' datatype='real' hidden='true' name='[Calculation_1257886765703184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF RIGHT(STR([Calculation_1257886780203028]),1) = &quot;1&quot; THEN&#13;&#10;    [Calculation_1257886780203028] - 7&#13;&#10;ELSE&#13;&#10;    [Calculation_1257886780203028] - 1&#13;&#10;END' />
      </column>
      <column caption='Previous Quarter Median Net Revenue' datatype='real' hidden='true' name='[Calculation_1257886765916178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(&#13;&#10;    IF [YEAR_QTR] = [Calculation_1257886765703184] THEN&#13;&#10;        [NET_TOT]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Selected Quarter Median Net Revenue' datatype='real' hidden='true' name='[Calculation_1257886772875283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(&#13;&#10;    IF [YEAR_QTR] = { MAX([YEAR_QTR]) }&#13;&#10;    THEN [NET_TOT]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Current Quarter' datatype='real' name='[Calculation_1257886780203028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ MAX([YEAR_QTR]) }' />
      </column>
      <column caption='Current Quarter Median Net Patient Revenue' datatype='real' name='[Calculation_1257886780891157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(&#13;&#10;    IF [YEAR_QTR] = [Calculation_1257886780203028]&#13;&#10;    THEN [NET_TOT]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Previous Quarter Median Net Patient Revenue' datatype='real' hidden='true' name='[Calculation_1257886780968982]' role='measure' type='quantitative'>
