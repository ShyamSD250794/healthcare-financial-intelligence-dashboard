        <calculation class='tableau' formula='STR(ROUND([Calculation_1191370145570835] * 100, 2))&#13;&#10;+ &quot;% Passed&quot;' />
      </column>
      <column caption='DQ - Checks By Type Subtitle' datatype='string' name='[Calculation_1191370207547413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; &#13;&#10;THEN &quot;All five quarters combined · negative equity excluded&quot;&#13;&#10;ELSE [Parameters].[Parameter 1784005467074563] + &quot; · negative equity excluded&quot;&#13;&#10;END' />
      </column>
      <column caption='DQ - Neg Equity Corrected' datatype='real' name='[Calculation_1191370209746966]' role='measure' type='quantitative'>
