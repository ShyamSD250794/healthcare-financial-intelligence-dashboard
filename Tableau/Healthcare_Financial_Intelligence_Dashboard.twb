    <worksheet name='PB - Revenue vs Peer % Display'>
      <table>
        <view>
          <datasources>
            <datasource caption='VW_FACILITY_LOCATION (SYSTEM.VW_FACILITY_LOCATION) (SYSTEM)' name='federated.1pdx1uj09bj3c811topkt1kvguux' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Hospital' datatype='string' name='[Parameter 1531665436008454]' param-domain-type='list' role='measure' type='nominal' value='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;'>
              <calculation class='tableau' formula='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;' />
            </column>
            <column caption='P1 - Selected Quarter' datatype='string' name='[Parameter 1784005467074563]' param-domain-type='list' role='measure' type='nominal' value='&quot;2026 Q1&quot;'>
              <calculation class='tableau' formula='&quot;2026 Q1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pdx1uj09bj3c811topkt1kvguux'>
            <column caption='PB - Revenue Benchmark Status' datatype='string' name='[Calculation_0185589019602944]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([Calculation_1531665446473739]) = 1 THEN&#13;&#10;    &quot;Singleton Peer Group&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL(MIN([PEER_MEDIAN_NET_TOT]))&#13;&#10;   OR MIN([PEER_MEDIAN_NET_TOT]) = 0 THEN&#13;&#10;    &quot;Peer median unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &lt; -5&#13;&#10;THEN&#13;&#10;    &quot;Below peer median&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &gt; 5&#13;&#10;THEN&#13;&#10;    &quot;Above peer median&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;At peer median&quot;&#13;&#10;END' />
            </column>
            <column caption='Quarter Label' datatype='string' name='[Calculation_1135014951743488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([YEAR_QTR] / 10))&#13;&#10;+ &quot; Q&quot;&#13;&#10;+ STR(INT([YEAR_QTR] - INT([YEAR_QTR] / 10) * 10))' />
            </column>
            <column caption='PB - Revenue vs Peer Median %' datatype='string' name='[Calculation_1327706515152896]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(MIN([PEER_MEDIAN_NET_TOT]))&#13;&#10;   OR MIN([PEER_MEDIAN_NET_TOT]) = 0&#13;&#10;THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(&#13;&#10;        (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100,&#13;&#10;        2&#13;&#10;    )) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='Selected Hospital Type' datatype='string' name='[Calculation_1531665440673801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF [FAC_NAME] = [Parameters].[Parameter 1531665436008454]&#13;&#10;    THEN [TYPE_HOSP]&#13;&#10;    END&#13;&#10;) }' />
            </column>
            <column caption='Is Peer Hospital' datatype='boolean' name='[Calculation_1531665440923658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[TYPE_HOSP] = [Calculation_1531665440673801]' />
            </column>
            <column caption='Peer Group Size' datatype='integer' name='[Calculation_1531665446473739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(&#13;&#10;    IF [Calculation_1531665440923658] THEN [FAC_NO] END&#13;&#10;) }' />
            </column>
            <column caption='PB - Selected Hospital' datatype='boolean' name='[Calculation_1784005555535917]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[FAC_NAME (VW_PEER_BENCHMARK)] = [Parameters].[Parameter 1531665436008454]' />
              <aliases>
                <alias key='false' value='Peer Facilities' />
                <alias key='true' value='Selected Hospital' />
              </aliases>
            </column>
            <column caption='PB - Selected Quarter' datatype='boolean' name='[Calculation_1784005556281390]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; &#13;&#10;THEN [YEAR_QTR] = { MAX([YEAR_QTR]) }&#13;&#10;ELSE [Calculation_1135014951743488] = [Parameters].[Parameter 1784005467074563]&#13;&#10;END' />
            </column>
            <column caption='Fac Name (Vw Peer Benchmark)' datatype='string' name='[FAC_NAME (VW_PEER_BENCHMARK)]' role='dimension' type='nominal' />
            <column caption='Fac Name' datatype='string' name='[FAC_NAME]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Fac No' datatype='real' name='[FAC_NO]' role='dimension' type='ordinal' />
            <column caption='Net Tot' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[NET_TOT]' role='measure' type='quantitative' />
            <column caption='Peer Median Net Tot' datatype='real' name='[PEER_MEDIAN_NET_TOT]' role='measure' type='quantitative' />
            <column caption='Type Hosp' datatype='string' name='[TYPE_HOSP]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Comparable&quot;' value='Comparable Facilities' />
              </aliases>
            </column>
            <column caption='Year Qtr' datatype='real' name='[YEAR_QTR]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1784005555535917]' derivation='None' name='[none:Calculation_1784005555535917:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1784005556281390]' derivation='None' name='[none:Calculation_1784005556281390:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0185589019602944]' derivation='User' name='[usr:Calculation_0185589019602944:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1327706515152896]' derivation='User' name='[usr:Calculation_1327706515152896:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1pdx1uj09bj3c811topkt1kvguux].[none:Calculation_1784005555535917:nk]'>
            <groupfilter function='member' level='[none:Calculation_1784005555535917:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1pdx1uj09bj3c811topkt1kvguux].[none:Calculation_1784005556281390:nk]'>
            <groupfilter function='member' level='[none:Calculation_1784005556281390:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
