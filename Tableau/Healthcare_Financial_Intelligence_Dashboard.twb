      <column caption='KPI - Days Cash QoQ Display' datatype='string' hidden='true' name='[Calculation_1531665418268674]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MEDIAN([DAYS_CASH_ON_HAND]), -1)) THEN&#13;&#10;    NULL&#13;&#10;ELSEIF MEDIAN([DAYS_CASH_ON_HAND]) - LOOKUP(MEDIAN([DAYS_CASH_ON_HAND]), -1) &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(ROUND(MEDIAN([DAYS_CASH_ON_HAND]) - LOOKUP(MEDIAN([DAYS_CASH_ON_HAND]), -1), 2))&#13;&#10;    + &quot; days vs prior quarter&quot;&#13;&#10;ELSEIF MEDIAN([DAYS_CASH_ON_HAND]) - LOOKUP(MEDIAN([DAYS_CASH_ON_HAND]), -1) &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(ROUND(ABS(MEDIAN([DAYS_CASH_ON_HAND]) - LOOKUP(MEDIAN([DAYS_CASH_ON_HAND]), -1)), 2))&#13;&#10;    + &quot; days vs prior quarter&quot;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00 days vs prior quarter&quot;&#13;&#10;END'>
