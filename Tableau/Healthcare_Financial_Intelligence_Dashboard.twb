    <worksheet name='Operating Margin Trend '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='9'>Operating Margin Trend</run>
            <run>Æ&#10;</run>
            <run bold='false' fontcolor='#4e79a7' fontsize='8'>■</run>
            <run bold='false' fontcolor='#000000' fontsize='8'> This hospital </run>
            <run bold='false' fontcolor='#898989' fontsize='8'>■</run>
            <run bold='false' fontcolor='#000000' fontsize='8'> Peer median </run>
            <run bold='false' fontcolor='#f28e2b' fontsize='8'>●</run>
            <run bold='false' fontcolor='#000000' fontsize='8'> Selected quarter</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='VW_FACILITY_LOCATION (SYSTEM.VW_FACILITY_LOCATION) (SYSTEM)' name='federated.1pdx1uj09bj3c811topkt1kvguux' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Hospital' datatype='string' name='[Parameter 1531665436008454]' param-domain-type='list' role='measure' type='nominal' value='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;'>
              <calculation class='tableau' formula='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;' />
            </column>
            <column caption='P1 - Selected Quarter' datatype='string' name='[Parameter 1784005467074563]' param-domain-type='list' role='measure' type='nominal' value='&quot;2026 Q1&quot;'>
              <calculation class='tableau' formula='&quot;2026 Q1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pdx1uj09bj3c811topkt1kvguux'>
            <column caption='Quarter Label' datatype='string' name='[Calculation_1135014951743488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([YEAR_QTR] / 10))&#13;&#10;+ &quot; Q&quot;&#13;&#10;+ STR(INT([YEAR_QTR] - INT([YEAR_QTR] / 10) * 10))' />
            </column>
            <column caption='PB - Operating Margin vs Peer Δ' datatype='string' name='[Calculation_1507751893614592]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;+&quot; +&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;END' />
            </column>
            <column caption='PB - Selected Quarter Highlight' datatype='real' name='[Calculation_1509677775921152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF STR([YEAR_QTR (VW_PEER_BENCHMARK)]) =&#13;&#10;   REPLACE([Parameters].[Parameter 1784005467074563], &quot; Q&quot;, &quot;&quot;)&#13;&#10;THEN&#13;&#10;    [OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)]&#13;&#10;END' />
            </column>
            <column caption='PB - Selected Hospital' datatype='boolean' name='[Calculation_1784005555535917]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[FAC_NAME (VW_PEER_BENCHMARK)] = [Parameters].[Parameter 1531665436008454]' />
              <aliases>
                <alias key='false' value='Peer Facilities' />
                <alias key='true' value='Selected Hospital' />
              </aliases>
            </column>
            <column caption='Fac Name (Vw Peer Benchmark)' datatype='string' name='[FAC_NAME (VW_PEER_BENCHMARK)]' role='dimension' type='nominal' />
            <column caption='Operating Margin Pct (Vw Peer Benchmark)' datatype='real' name='[OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)]' role='measure' type='quantitative' />
            <column caption='Peer Median Operating Margin' datatype='real' name='[PEER_MEDIAN_OPERATING_MARGIN]' role='measure' type='quantitative' />
