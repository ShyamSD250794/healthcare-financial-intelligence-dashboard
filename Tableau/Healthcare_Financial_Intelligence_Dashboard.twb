      <column caption='PB - Operating Margin Status' datatype='string' name='[Calculation_1616878633799680]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;ELSEIF ABS(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) &lt;= 0.05 THEN&#13;&#10;    &quot;At peer median&quot;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;Above peer median&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Below peer median&quot;&#13;&#10;END' />
