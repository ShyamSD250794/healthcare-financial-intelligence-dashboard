      <column caption='Previous Quarter Median LT Debt To Asset' datatype='real' hidden='true' name='[Calculation_0081134032453632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    MEDIAN(&#13;&#10;        IF [YEAR_QTR] =&#13;&#10;            IF RIGHT(STR({ MAX([YEAR_QTR]) }), 1) = &quot;1&quot;&#13;&#10;            THEN { MAX([YEAR_QTR]) } - 7&#13;&#10;            ELSE { MAX([YEAR_QTR]) } - 1&#13;&#10;            END&#13;&#10;        THEN [LT_DEBT_TO_ASSET_PCT (VW_FACILITY_RISK)]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='LT Debt To Asset QoQ Change pp' datatype='real' hidden='true' name='[Calculation_0081134033076225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([LT_DEBT_TO_ASSET_PCT (VW_FACILITY_RISK)])&#13;&#10;-&#13;&#10;MIN([Calculation_0081134032453632])' />
      </column>
      <column caption='LT Debt To Asset QoQ Display' datatype='string' hidden='true' name='[Calculation_0081134033342466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0081134033076225] &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; + STR(ROUND(ABS([Calculation_0081134033076225]), 2))&#13;&#10;    + &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0081134033076225] &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; + STR(ROUND([Calculation_0081134033076225], 2))&#13;&#10;    + &quot; pp vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0 pp vs prior quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Latest Quarter' datatype='boolean' name='[Calculation_0081134069198851]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[YEAR_QTR] = { MAX([YEAR_QTR]) }' />
      </column>
      <column caption='Current Median Days Cash On Hand' datatype='real' name='[Calculation_0081134161588230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(&#13;&#10;    IF [Calculation_0081134069198851] THEN&#13;&#10;        [NET_TOT]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='PB - Revenue Benchmark Status' datatype='string' name='[Calculation_0185589019602944]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Calculation_1531665446473739]) = 1 THEN&#13;&#10;    &quot;Singleton Peer Group&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL(MIN([PEER_MEDIAN_NET_TOT]))&#13;&#10;   OR MIN([PEER_MEDIAN_NET_TOT]) = 0 THEN&#13;&#10;    &quot;Peer median unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &lt; -5&#13;&#10;THEN&#13;&#10;    &quot;Below peer median&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &gt; 5&#13;&#10;THEN&#13;&#10;    &quot;Above peer median&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;At peer median&quot;&#13;&#10;END' />
      </column>
      <column caption='PB - Revenue % Color' datatype='string' name='[Calculation_0185589024350210]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(MIN([PEER_MEDIAN_NET_TOT]))&#13;&#10;   OR MIN([PEER_MEDIAN_NET_TOT]) = 0&#13;&#10;THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &lt; -5&#13;&#10;THEN&#13;&#10;    &quot;Below&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    (SUM([NET_TOT]) / MIN([PEER_MEDIAN_NET_TOT]) - 1) * 100 &gt; 5&#13;&#10;THEN&#13;&#10;    &quot;Above&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Neutral&quot;&#13;&#10;END' />
      </column>
      <column caption='P3 - With Any Flag' datatype='real' name='[Calculation_0561074871136256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1677628466520064] AND [RISK_FLAG_COUNT] &gt;= 1 THEN [FAC_NO] END' />
      </column>
      <column caption='P3 - Pct Any Flag' datatype='real' name='[Calculation_0561074871386113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0561074871136256]) / COUNTD([Calculation_1677628467814401])' />
      </column>
      <column caption='P3 - With 3Plus Flags' datatype='real' name='[Calculation_0561074872139778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1677628466520064] AND [RISK_FLAG_COUNT] &gt;= 3 THEN [FAC_NO] END' />
      </column>
      <column caption='P3 - Pct 3Plus Flags' datatype='real' name='[Calculation_0561074872225795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0561074872139778]) / COUNTD([Calculation_1677628467814401])' />
      </column>
      <column caption='P3 - With 4Plus Flags' datatype='real' name='[Calculation_0561074873556996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1677628466520064] AND [RISK_FLAG_COUNT] &gt;= 4 THEN [FAC_NO] END' />
      </column>
      <column caption='P3 - Pct 4Plus Flags' datatype='real' name='[Calculation_0561074873663493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0561074873556996]) / COUNTD([Calculation_1677628467814401])' />
      </column>
      <column caption='PB - Same Peer Group' datatype='boolean' name='[Calculation_0562450183647232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[TYPE_HOSP (VW_PEER_BENCHMARK)] = [Calculation_1531665440673801]' />
      </column>
      <column caption='PB - Jitter' datatype='real' name='[Calculation_0562450183786497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[FAC_NO (VW_PEER_BENCHMARK)] % 31' />
      </column>
      <column caption='PB - Peer Median CR' datatype='real' name='[Calculation_0562450183888898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1784005555535917] THEN [PEER_MEDIAN_CURRENT_RATIO] END' />
      </column>
      <column caption='PB - Selected Label' datatype='string' name='[Calculation_0562450246103043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1784005555535917] THEN STR(ROUND([CURRENT_RATIO (VW_PEER_BENCHMARK)], 2)) + &quot;x&quot; END' />
      </column>
      <column caption='R3 - Any Flag Sub' datatype='string' hidden='true' name='[Calculation_0955797640642561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MAX([PCT_ANY_FLAG])) + &quot;% of monitored facilities&quot;' />
      </column>
      <column caption='R3 - 3+ Flag Sub' datatype='string' hidden='true' name='[Calculation_0955797640708098]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MAX([PCT_3PLUS])) + &quot;% of monitored facilities&quot;' />
      </column>
      <column caption='R3 - Profile Label' datatype='string' name='[Calculation_0955797755682819]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([FAC_NO (VW_FACILITY_RISK)])) + &quot; (&quot; +&#13;&#10;STR(ROUND(COUNTD([FAC_NO (VW_FACILITY_RISK)]) /&#13;&#10;TOTAL(COUNTD([FAC_NO (VW_FACILITY_RISK)])) * 100, 1)) + &quot;%)&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Flags Txt' datatype='string' hidden='true' name='[Calculation_0955797763604484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID(&#13;&#10;  IF ZN([CURRENT_RATIO_RISK (VW_RISK_WATCHLIST)]) = 1 THEN &quot;, Current ratio&quot; ELSE &quot;&quot; END&#13;&#10;+ IF ZN([LT_DEBT_RISK (VW_RISK_WATCHLIST)]) = 1 THEN &quot;, LT debt&quot; ELSE &quot;&quot; END&#13;&#10;+ IF ZN([NEGATIVE_EQUITY_RISK (VW_RISK_WATCHLIST)]) = 1 THEN &quot;, Equity&quot; ELSE &quot;&quot; END&#13;&#10;+ IF ZN([NEGATIVE_ROA_RISK (VW_RISK_WATCHLIST)]) = 1 THEN &quot;, ROA&quot; ELSE &quot;&quot; END&#13;&#10;+ IF ZN([NEGATIVE_ROE_RISK (VW_RISK_WATCHLIST)]) = 1 THEN &quot;, ROE&quot; ELSE &quot;&quot; END, 3)' />
      </column>
      <column caption='R3 - Change Color' datatype='string' name='[Calculation_0955797763698693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [FLAG_CHANGE] &gt; 0 THEN &quot;Worse&quot;&#13;&#10;ELSEIF [FLAG_CHANGE] &lt; 0 THEN &quot;Better&quot;&#13;&#10;ELSE &quot;Same&quot; END' />
      </column>
      <column caption='R3 - Top 10' datatype='boolean' name='[Calculation_0955797763833862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[WATCH_RANK] &lt;= 10' />
      </column>
      <column caption='R3 - Change Header' datatype='string' name='[Calculation_0955797767737351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;vs last quarter&quot;' />
      </column>
      <column caption='Quarter Label' datatype='string' name='[Calculation_1135014951743488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([YEAR_QTR] / 10))&#13;&#10;+ &quot; Q&quot;&#13;&#10;+ STR(INT([YEAR_QTR] - INT([YEAR_QTR] / 10) * 10))' />
      </column>
      <column caption='Previous Quarter Facilities' datatype='integer' hidden='true' name='[Calculation_1135014953684993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF [YEAR_QTR] =&#13;&#10;            IF RIGHT(STR({ MAX([YEAR_QTR]) }), 1) = &quot;1&quot;&#13;&#10;            THEN { MAX([YEAR_QTR]) } - 7&#13;&#10;            ELSE { MAX([YEAR_QTR]) } - 1&#13;&#10;            END&#13;&#10;        THEN [FAC_NO]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Facility QoQ Change' datatype='integer' hidden='true' name='[Calculation_1135014954381314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([FAC_NO]) - MIN([Calculation_1135014953684993])' />
      </column>
      <column caption='Facility QoQ Display' datatype='string' hidden='true' name='[Calculation_1135014955761667]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1135014954381314] &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; + STR(ABS([Calculation_1135014954381314])) + &quot; vs prior quarter&quot;&#13;&#10;ELSEIF [Calculation_1135014954381314] &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; + STR([Calculation_1135014954381314]) + &quot; vs prior quarter&quot;&#13;&#10;ELSE&#13;&#10;    &quot;→ 0 vs prior quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='Net Revenue QoQ Change %' datatype='real' hidden='true' name='[Calculation_1135014991802373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    MEDIAN(&#13;&#10;        IF [Calculation_0081134069198851] THEN&#13;&#10;            [NET_TOT]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    -&#13;&#10;    [Calculation_1257886765916178]&#13;&#10;)&#13;&#10;/&#13;&#10;ABS([Calculation_1257886765916178])' />
      </column>
      <column caption='Net Revenue QoQ Display' datatype='string' hidden='true' name='[Calculation_1135014992932870]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1257886780891157]&#13;&#10;   &gt; [Calculation_1257886780968982]&#13;&#10;THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            (&#13;&#10;                (&#13;&#10;                    [Calculation_1257886780891157]&#13;&#10;                    -&#13;&#10;                    [Calculation_1257886780968982]&#13;&#10;                )&#13;&#10;                /&#13;&#10;                [Calculation_1257886780968982]&#13;&#10;            ) * 100,&#13;&#10;            2&#13;&#10;        )&#13;&#10;    )&#13;&#10;    + &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1257886780891157]&#13;&#10;   &lt; [Calculation_1257886780968982]&#13;&#10;THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            ABS(&#13;&#10;                (&#13;&#10;                    [Calculation_1257886780891157]&#13;&#10;                    -&#13;&#10;                    [Calculation_1257886780968982]&#13;&#10;                )&#13;&#10;                /&#13;&#10;                [Calculation_1257886780968982]&#13;&#10;            ) * 100,&#13;&#10;            2&#13;&#10;        )&#13;&#10;    )&#13;&#10;    + &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00% vs prior quarter&quot;&#13;&#10;END' />
      </column>
