  <worksheets>
    <worksheet name='Current Ratio'>
      <table>
        <view>
          <datasources>
            <datasource caption='VW_FACILITY_LOCATION (SYSTEM.VW_FACILITY_LOCATION) (SYSTEM)' name='federated.1pdx1uj09bj3c811topkt1kvguux' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P1 - Selected Quarter' datatype='string' name='[Parameter 1784005467074563]' param-domain-type='list' role='measure' type='nominal' value='&quot;2026 Q1&quot;'>
              <calculation class='tableau' formula='&quot;2026 Q1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pdx1uj09bj3c811topkt1kvguux'>
            <column caption='Current Ratio' datatype='real' name='[CURRENT_RATIO]' role='measure' type='quantitative' />
            <column caption='P1 - Quarter Index' datatype='integer' name='[Calculation_1784005465563136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([YEAR_QTR]/10)*4 + (INT([YEAR_QTR]) - INT([YEAR_QTR]/10)*10) - 1' />
            </column>
            <column caption='P1 - Selected Quarter Index' datatype='integer' name='[Calculation_1784005467750404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; THEN NULL&#13;&#10;ELSE INT(LEFT([Parameters].[Parameter 1784005467074563], 4)) * 4&#13;&#10;     + INT(RIGHT([Parameters].[Parameter 1784005467074563], 1)) - 1&#13;&#10;END' />
            </column>
            <column caption='P1 - Include Row' datatype='boolean' name='[Calculation_1784005467848709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1784005467074563] = &quot;All&quot; OR [Calculation_1784005465563136] = [Calculation_1784005467750404]' />
            </column>
            <column caption='P1 - Current Ratio Current' datatype='real' name='[Calculation_1784005474148370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1784005467848709] THEN [CURRENT_RATIO] END' />
            </column>
            <column caption='P1 - Current Ratio Prev' datatype='real' name='[Calculation_1784005474263059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] &lt;&gt; &quot;All&quot;&#13;&#10;   AND [Calculation_1784005465563136] = [Calculation_1784005467750404] - 1&#13;&#10;THEN [CURRENT_RATIO] END' />
            </column>
            <column caption='P1 - Current Ratio QoQ' datatype='real' name='[Calculation_1784005474340884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([Calculation_1784005474148370]) - MEDIAN([Calculation_1784005474263059])' />
            </column>
            <column caption='P1 - Current Ratio QoQ Display' datatype='string' name='[Calculation_1784005485707298]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_1784005474340884]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1784005474340884] &gt; 0 THEN &quot;▲ +&quot; + STR(ROUND([Calculation_1784005474340884], 2))&#13;&#10;ELSEIF [Calculation_1784005474340884] &lt; 0 THEN &quot;▼ &quot; + STR(ROUND([Calculation_1784005474340884], 2))&#13;&#10;ELSE &quot;— no change&quot;&#13;&#10;END' />
            </column>
            <column caption='Year Qtr' datatype='real' name='[YEAR_QTR]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_1784005474148370]' derivation='Median' name='[med:Calculation_1784005474148370:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1784005485707298]' derivation='User' name='[usr:Calculation_1784005485707298:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
