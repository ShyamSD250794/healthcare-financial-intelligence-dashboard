    <worksheet name='Key Financial Metrics vs Peer Median'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='9'>Key Financial Metrics vs Peer Group Median</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='VW_FACILITY_LOCATION (SYSTEM.VW_FACILITY_LOCATION) (SYSTEM)' name='federated.1pdx1uj09bj3c811topkt1kvguux' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Hospital' datatype='string' name='[Parameter 1531665436008454]' param-domain-type='list' role='measure' type='nominal' value='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;'>
              <calculation class='tableau' formula='&quot;ADVENTIST HEALTH HOWARD MEMORIAL&quot;' />
            </column>
            <column caption='P1 - Selected Quarter' datatype='string' name='[Parameter 1784005467074563]' param-domain-type='list' role='measure' type='nominal' value='&quot;2026 Q1&quot;'>
              <calculation class='tableau' formula='&quot;2026 Q1&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pdx1uj09bj3c811topkt1kvguux'>
            <column caption='Cash' datatype='real' name='[CASH]' role='measure' type='quantitative' />
            <column caption='Collection Rate Pct' datatype='real' name='[COLLECTION_RATE_PCT]' role='measure' type='quantitative' />
            <column caption='Cost To Charge Ratio' datatype='real' name='[COST_TO_CHARGE_RATIO]' role='measure' type='quantitative' />
            <column caption='Current Ratio (Vw Facility Risk)' datatype='real' name='[CURRENT_RATIO (VW_FACILITY_RISK)]' role='measure' type='quantitative' />
            <column caption='Current Ratio (Vw Peer Benchmark)' datatype='real' name='[CURRENT_RATIO (VW_PEER_BENCHMARK)]' role='measure' type='quantitative' />
            <column caption='Current Ratio' datatype='real' name='[CURRENT_RATIO]' role='measure' type='quantitative' />
            <column caption='Current Ratio Risk' datatype='real' name='[CURRENT_RATIO_RISK]' role='measure' type='quantitative' />
            <column caption='Is Latest Quarter' datatype='boolean' name='[Calculation_0081134069198851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[YEAR_QTR] = { MAX([YEAR_QTR]) }' />
            </column>
            <column caption='Current Median Days Cash On Hand' datatype='real' name='[Calculation_0081134161588230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(&#13;&#10;    IF [Calculation_0081134069198851] THEN&#13;&#10;        [NET_TOT]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Quarter Label' datatype='string' name='[Calculation_1135014951743488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([YEAR_QTR] / 10))&#13;&#10;+ &quot; Q&quot;&#13;&#10;+ STR(INT([YEAR_QTR] - INT([YEAR_QTR] / 10) * 10))' />
            </column>
            <column caption='Current Median Net Patient Revenue' datatype='real' name='[Calculation_1257886752710670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    MEDIAN(&#13;&#10;        IF [Calculation_0081134069198851] THEN&#13;&#10;            [NET_TOT]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Current Quarter' datatype='real' name='[Calculation_1257886780203028]' role='measure' type='quantitative'>
