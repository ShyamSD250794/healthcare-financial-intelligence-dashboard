          <zone forceUpdate='true' h='33000' id='22' type-v2='text' w='31786' x='67500' y='61500'>
            <formatted-text>
              <run bold='true' fontcolor='#000000'>How to read these numbers?</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Net patient revenue ≠ net income</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Peer medians use the same hospital type and quarter, excluding the selected hospital</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Blank = unavailable, not zero</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Exceptions and outliers are review flags, not confirmed errors</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Two Kaiser regional entities report no beds; occupancy is therefore blank</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='8'>• Occupancy may exceed 100% during surges and is informational</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
