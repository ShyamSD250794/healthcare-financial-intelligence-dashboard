      <column caption='Median Net Patient Revenue QoQ %' datatype='real' hidden='true' name='[Calculation_1257886781038615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1257886780891157]&#13;&#10;    -&#13;&#10;    [Calculation_1257886780968982]&#13;&#10;)&#13;&#10;/&#13;&#10;[Calculation_1257886780968982]' />
      </column>
      <column caption='Median Net Patient Revenue QoQ Display' datatype='string' hidden='true' name='[Calculation_1257886785339416]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1257886781038615] &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(ROUND([Calculation_1257886781038615] * 100, 2)) +&#13;&#10;    &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1257886781038615] &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(ROUND(ABS([Calculation_1257886781038615]) * 100, 2)) +&#13;&#10;    &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00% vs prior quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='Median Net Patient Revenue QoQ' datatype='string' hidden='true' name='[Calculation_1257886786654233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1257886781038615] &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; + STR(ROUND([Calculation_1257886781038615] * 100, 2))&#13;&#10;    + &quot;% vs prior quarter&quot;&#13;&#10;ELSEIF [Calculation_1257886781038615] &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; + STR(ROUND(ABS([Calculation_1257886781038615]) * 100, 2))&#13;&#10;    + &quot;% vs prior quarter&quot;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00% vs prior quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='KPI - Net Revenue QoQ Display' datatype='string' hidden='true' name='[Calculation_1257886788915227]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(MEDIAN([NET_TOT]), -1)) THEN&#13;&#10;    NULL&#13;&#10;&#13;&#10;ELSEIF MEDIAN([NET_TOT]) &gt; LOOKUP(MEDIAN([NET_TOT]), -1) THEN&#13;&#10;    &quot;▲ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            (&#13;&#10;                MEDIAN([NET_TOT])&#13;&#10;                /&#13;&#10;                LOOKUP(MEDIAN([NET_TOT]), -1)&#13;&#10;                - 1&#13;&#10;            ) * 100,&#13;&#10;            2&#13;&#10;        )&#13;&#10;    ) +&#13;&#10;    &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSEIF MEDIAN([NET_TOT]) &lt; LOOKUP(MEDIAN([NET_TOT]), -1) THEN&#13;&#10;    &quot;▼ &quot; +&#13;&#10;    STR(&#13;&#10;        ROUND(&#13;&#10;            ABS(&#13;&#10;                (&#13;&#10;                    MEDIAN([NET_TOT])&#13;&#10;                    /&#13;&#10;                    LOOKUP(MEDIAN([NET_TOT]), -1)&#13;&#10;                    - 1&#13;&#10;                ) * 100&#13;&#10;            ),&#13;&#10;            2&#13;&#10;        )&#13;&#10;    ) +&#13;&#10;    &quot;% vs prior quarter&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;● 0.00% vs prior quarter&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Show Latest Quarter' datatype='boolean' hidden='true' name='[Calculation_1257886792040477]' role='measure' type='nominal'>
