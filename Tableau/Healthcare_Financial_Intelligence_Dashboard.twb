              <calculation class='tableau' formula='INT([YEAR_QTR]/10)*4 + (INT([YEAR_QTR]) - INT([YEAR_QTR]/10)*10) - 1' />
            </column>
            <column caption='P1 - Selected Quarter Index' datatype='integer' name='[Calculation_1784005467750404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; THEN NULL&#13;&#10;ELSE INT(LEFT([Parameters].[Parameter 1784005467074563], 4)) * 4&#13;&#10;     + INT(RIGHT([Parameters].[Parameter 1784005467074563], 1)) - 1&#13;&#10;END' />
            </column>
            <column caption='P1 - Include Row' datatype='boolean' name='[Calculation_1784005467848709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1784005467074563] = &quot;All&quot; OR [Calculation_1784005465563136] = [Calculation_1784005467750404]' />
