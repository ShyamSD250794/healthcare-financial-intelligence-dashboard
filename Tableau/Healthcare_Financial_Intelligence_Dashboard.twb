            <column caption='Quarter Label' datatype='string' name='[Calculation_1135014951743488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT([YEAR_QTR] / 10))&#13;&#10;+ &quot; Q&quot;&#13;&#10;+ STR(INT([YEAR_QTR] - INT([YEAR_QTR] / 10) * 10))' />
            </column>
            <column caption='PB - Operating Margin vs Peer Δ' datatype='string' name='[Calculation_1507751893614592]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;+&quot; +&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    STR(ROUND(&#13;&#10;        SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;        - SUM([PEER_MEDIAN_OPERATING_MARGIN]), 2&#13;&#10;    )) + &quot; pp&quot;&#13;&#10;END' />
            </column>
            <column caption='PB - Operating Margin Status' datatype='string' name='[Calculation_1616878633799680]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) THEN&#13;&#10;    &quot;Unavailable&quot;&#13;&#10;ELSEIF ABS(&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN])&#13;&#10;) &lt;= 0.05 THEN&#13;&#10;    &quot;At peer median&quot;&#13;&#10;ELSEIF&#13;&#10;    SUM([OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)])&#13;&#10;    - SUM([PEER_MEDIAN_OPERATING_MARGIN]) &gt; 0&#13;&#10;THEN&#13;&#10;    &quot;Above peer median&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Below peer median&quot;&#13;&#10;END' />
            </column>
            <column caption='PB - Selected Hospital' datatype='boolean' name='[Calculation_1784005555535917]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[FAC_NAME (VW_PEER_BENCHMARK)] = [Parameters].[Parameter 1531665436008454]' />
              <aliases>
                <alias key='false' value='Peer Facilities' />
                <alias key='true' value='Selected Hospital' />
              </aliases>
            </column>
            <column caption='PB - Selected Quarter' datatype='boolean' name='[Calculation_1784005556281390]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1784005467074563] = &quot;All&quot; &#13;&#10;THEN [YEAR_QTR] = { MAX([YEAR_QTR]) }&#13;&#10;ELSE [Calculation_1135014951743488] = [Parameters].[Parameter 1784005467074563]&#13;&#10;END' />
            </column>
            <column caption='Fac Name (Vw Peer Benchmark)' datatype='string' name='[FAC_NAME (VW_PEER_BENCHMARK)]' role='dimension' type='nominal' />
            <column caption='Operating Margin Pct (Vw Peer Benchmark)' datatype='real' name='[OPERATING_MARGIN_PCT (VW_PEER_BENCHMARK)]' role='measure' type='quantitative' />
            <column caption='Peer Median Operating Margin' datatype='real' name='[PEER_MEDIAN_OPERATING_MARGIN]' role='measure' type='quantitative' />
